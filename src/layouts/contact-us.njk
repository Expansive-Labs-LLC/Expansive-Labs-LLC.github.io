  <!-- <link href="/static/assets/demo/demo.css" rel="stylesheet" /> -->

</head>

<body class="{{ body_class }}">

  {% include "navigation-sticky.njk" %}
  
<header>
    <div class="page-header section-height-85">
      <div>
        <img class="position-absolute fixed-top ms-auto w-sm-100 h-100 z-index-0 border-radius-section border-top-end-radius-0 border-top-start-radius-0 border-bottom-end-radius-0" src="/static/assets/img/expansiveLabsLogo5.jpg">
      </div>
      <div class="container">
        <div class="row">
          <div class="col-lg-7 d-flex justify-content-center flex-column">
            <div class="card d-flex justify-content-center p-4 shadow-lg my-sm-0 my-sm-6 mt-8 mb-5" style="background-color: rgba(255, 255, 255, 0.85);">
              <div class="text-center">
                <h3 class="text-gradient text-info"> {{ header }} </h3>
                <p class="mb-0">
                  {{ content|safe }}
                </p>
              </div>
              <div class="card card-plain">
                <form id="contactForm" method="post" autocomplete="off">
                  <div class="card-body pb-2">
                    <div class="row">
                      <div class="col-md-6">
                        <label for="name">{{ name }}</label>
                        <div class="input-group mb-4">
                          <input type="text" id="name" name="name" class="form-control" placeholder="Full Name" aria-label="name" required maxlength="200">
                        </div>
                      </div>
                      <div class="col-md-6 ps-md-2">
                        <label for="email">{{ email }}</label>
                        <div class="input-group">
                          <input type="email" id="email" name="email" class="form-control" placeholder="info@expansivelabs.io" required maxlength="254">
                        </div>
                      </div>
                    </div>
                    <div class="form-group mb-0 mt-md-0 mt-4">
                      <label for="message">{{ prompt }}</label>
                      <textarea class="form-control" id="message" name="message" rows="6" placeholder="Describe your problem in at least 250 characters" required maxlength="5000"></textarea>
                    </div>
                    <!-- Honeypot: the contact API silently drops any submission that fills this in. -->
                    <div class="form-group d-none" aria-hidden="true">
                      <label for="company_website">Leave this field empty</label>
                      <input type="text" id="company_website" name="company_website" class="form-control" tabindex="-1" autocomplete="off">
                    </div>
                    <div class="row">
                      <div class="col-md-12 text-center">
                          <input type="submit" id="contactSubmit" value="Submit"/>
                      </div>
                    </div>
                    <p class="text-xs text-center mt-3 mb-0">
                      This site is protected by reCAPTCHA and the Google
                      <a href="https://policies.google.com/privacy">Privacy Policy</a> and
                      <a href="https://policies.google.com/terms">Terms of Service</a> apply.
                    </p>
                  </div>
                </form>
                <div id="response" role="status" aria-live="polite"></div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
</header>

  {#
    Wiring lives in src/data/contact.json.

    endpoint is the ExpansiveLabsWebsiteStack API in the infrastructure repo.
    It verifies every submission server-side with reCAPTCHA v3; the old
    hand-built execute-api URL checked nothing and must not come back.

    recaptchaSiteKey is the public v3 SITE key, registered for expansivelabs.io
    and www.expansivelabs.io. Its paired SECRET key lives in Secrets Manager as
    google/recaptcha/expansive-labs, never in this repo. While it is blank the
    form stays disabled and points visitors at the email address instead.
  #}
  {% if contact.recaptchaSiteKey %}
  <script src="https://www.google.com/recaptcha/api.js?render={{ contact.recaptchaSiteKey }}"></script>
  {% endif %}
  <script>
    (function () {
      const ENDPOINT = {{ contact.endpoint | dump | safe }};
      const SITE_KEY = {{ contact.recaptchaSiteKey | dump | safe }};
      const FALLBACK = 'Please email us at info@expansivelabs.io instead.';
      const renderedAt = Date.now();

      const form = document.getElementById('contactForm');
      const submit = document.getElementById('contactSubmit');
      const responseDiv = document.getElementById('response');

      if (!SITE_KEY) {
        submit.disabled = true;
        responseDiv.innerText = 'The contact form is temporarily unavailable. ' + FALLBACK;
        return;
      }

      function recaptchaToken() {
        return new Promise(function (resolve, reject) {
          if (!window.grecaptcha) {
            reject(new Error('reCAPTCHA did not load'));
            return;
          }
          grecaptcha.ready(function () {
            grecaptcha.execute(SITE_KEY, { action: 'contact' }).then(resolve, reject);
          });
        });
      }

      form.addEventListener('submit', function (e) {
        e.preventDefault();
        submit.disabled = true;
        responseDiv.innerText = 'Sending…';

        recaptchaToken()
          .then(function (token) {
            return fetch(ENDPOINT, {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                formType: 'contact',
                name: form.name.value,
                email: form.email.value,
                message: form.message.value,
                company_website: form.company_website.value,
                renderedAt: renderedAt,
                submittedAt: Date.now(),
                captchaToken: token
              })
            });
          })
          .then(function (response) {
            return response.json().catch(function () { return {}; }).then(function (data) {
              if (!response.ok) {
                throw new Error(data.error || ('HTTP ' + response.status));
              }
              form.reset();
              responseDiv.innerText = 'Message sent successfully!';
            });
          })
          .catch(function (error) {
            console.error('Contact form error:', error);
            submit.disabled = false;
            responseDiv.innerText = 'We could not send your message. ' + FALLBACK;
          });
      });
    })();
  </script>

  {% include "footer.njk" %}

  {% include "scripts.njk" %}

  <script src="/static/assets/js/soft-design-system-pro.min.js?v=1.0.0" type="text/javascript"></script>
  <!--  Google Maps Plugin    -->
  <script src="/static/assets/js/soft-design-system-pro.min.js?v=1.0.1" type="text/javascript"></script>
  <script type="text/javascript">
    if (document.getElementById('state1')) {
      const countUp = new CountUp('state1', document.getElementById("state1").getAttribute("countTo"));
      if (!countUp.error) {
        countUp.start();
      } else {
        console.error(countUp.error);
      }
    }
    if (document.getElementById('state2')) {
      const countUp1 = new CountUp('state2', document.getElementById("state2").getAttribute("countTo"));
      if (!countUp1.error) {
        countUp1.start();
      } else {
        console.error(countUp1.error);
      }
    }
    if (document.getElementById('state3')) {
      const countUp2 = new CountUp('state3', document.getElementById("state3").getAttribute("countTo"));
      if (!countUp2.error) {
        countUp2.start();
      } else {
        console.error(countUp2.error);
      };
    }
  </script>
</body>
</html>
